# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5174
FRONTEND_URL=http://localhost:5174

# Database & Authentication Secrets
MONGO_URI=mongodb://localhost:27017/auth_db
JWT_SECRET=your_jwt_super_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret

# Firebase Admin Configuration (for Google OAuth & Token Verification)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key\n-----END PRIVATE KEY-----\n"

# AI Security Gateway Integration
SECURITY_GATEWAY_URL=http://localhost:5000
SECURITY_GATEWAY_API_KEY=your_admin_gateway_api_key_12345
SECURITY_ALERT_COOLDOWN_MINUTES=15

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_SIGNUP_MAX=15
RATE_LIMIT_FORGOT_MAX=10
RATE_LIMIT_OTP_MAX=15
RATE_LIMIT_RESET_MAX=10
RATE_LIMIT_ADMIN_MAX=300
RATE_LIMIT_TEST_MAX=300

# OTP & Email Configuration
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@security.com
EMAIL_PASS=your_smtp_password
BREVO_API_KEY=your_optional_brevo_api_key

# Cloudinary (Optional file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
